# =================================================================
# CineScope Environment Variables Configuration
# Copy this file to .env before starting the application locally
# =================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (For local non-docker development use localhost, in docker compose use mongodb)
MONGO_URI=mongodb://localhost:27017/cinescope

# Authentication & Security
# WARNING: In production environments, use a strong cryptographically random secret!
JWT_SECRET=cinescope_development_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# Default Initial Administrator Credentials (seeded safely on startup if not present)
ADMIN_EMAIL=admin@cinescope.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=CineScope Administrator

# Frontend Configuration
VITE_API_URL=http://localhost:5000/api
